// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  BUSINESS
}

enum CouponStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InviteStatus {
  PENDING
  REGISTERED
  ACTIVE
}

enum CouponType {
  ONLINE_CODE
  QR_CODE
}

enum UsageLimitType {
  SINGLE_USE
  MULTIPLE_USE
  UNLIMITED
}

enum DiscountType {
  PERCENT
  FIXED
  BOGO_1_1
  BOGO_2_1
}

enum CommunityDealStatus {
  ACTIVE
  EXPIRED
  REPORTED
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  name                String
  address             String?
  birthDate           DateTime?
  phone               String?
  about               String?   @db.Text
  businessDescription String?   @db.Text
  businessCategories  String[]  @default([])
  businessLocation    String?
  businessWebsite     String?
  businessInstagram   String?
  businessFacebook    String?
  businessTikTok      String?
  businessLatitude    Float?
  businessLongitude   Float?
  role                Role      @default(USER)
  membershipExpiry    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  coupons           Coupon[]           @relation("BusinessCoupons")
  couponRedemptions CouponRedemption[]
  sentInvites       BusinessInvite[]   @relation("InviterInvites")
  receivedInvites   BusinessInvite[]   @relation("InvitedBusiness")
  communityDeals    CommunityDeal[]
  communityDealComments CommunityDealComment[]
  communityDealVotes    CommunityDealVote[]

  @@index([email])
  @@index([role])
}

model Category {
  id        String   @id @default(cuid())
  nameEn    String   @unique
  nameEl    String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  // Relations
  coupons Coupon[]

  @@index([slug])
}

model Coupon {
  id                  String         @id @default(cuid())
  businessId          String
  categoryId          String
  title               String
  description         String         @db.Text
  code                String?
  couponType          CouponType     @default(ONLINE_CODE)
  imagePath           String?
  discountType        DiscountType   @default(PERCENT)
  discountPercentage  Int? // For PERCENT type
  discountAmount      Float? // For FIXED type (in currency units)
  expirationDate      DateTime
  status              CouponStatus   @default(PENDING)
  usageLimitType      UsageLimitType @default(SINGLE_USE)
  maxUsesPerUser      Int?
  hasTimeRestrictions Boolean        @default(false)
  validDays           Int[]          @default([])
  validStartHour      Int?
  validEndHour        Int?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  business    User               @relation("BusinessCoupons", fields: [businessId], references: [id], onDelete: Cascade)
  category    Category           @relation(fields: [categoryId], references: [id])
  analytics   CouponAnalytics[]
  redemptions CouponRedemption[]

  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([expirationDate])
}

model CouponAnalytics {
  id        String   @id @default(cuid())
  couponId  String
  eventType String // 'VIEW', 'CLICK', 'REDEMPTION'
  userId    String? // Optional - track which user (if authenticated)
  ipAddress String? // Optional - for anonymous tracking
  userAgent String? // Optional - browser/device info
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
}

model CouponRedemption {
  id              String    @id @default(cuid())
  couponId        String
  userId          String
  redemptionToken String    @unique
  redeemedAt      DateTime?
  createdAt       DateTime  @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([redemptionToken])
  @@index([couponId])
  @@index([userId])
  @@index([redeemedAt])
  @@index([couponId, userId])
}

model BusinessInvite {
  id                String       @id @default(cuid())
  inviterId         String
  invitedBusinessId String
  status            InviteStatus @default(PENDING)
  rewardGranted     Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  // Relations
  inviter         User @relation("InviterInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  invitedBusiness User @relation("InvitedBusiness", fields: [invitedBusinessId], references: [id], onDelete: Cascade)

  @@unique([inviterId, invitedBusinessId])
  @@index([inviterId])
  @@index([invitedBusinessId])
  @@index([status])
}

model SiteSettings {
  id                 String   @id @default("default")
  useRealStats       Boolean  @default(true)
  fakeTotalCoupons   Int      @default(0)
  fakeActiveMembers  Int      @default(0)
  fakeTotalBusinesses Int     @default(0)
  fakeTotalSavings   Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CommunityDeal {
  id          String              @id @default(cuid())
  title       String
  description String              @db.Text
  category    String
  location    String
  latitude    Float?
  longitude   Float?
  imageUrl    String
  couponCode  String?
  userId      String
  createdAt   DateTime            @default(now())
  expiresAt   DateTime
  status      CommunityDealStatus @default(ACTIVE)

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments CommunityDealComment[]
  votes    CommunityDealVote[]

  @@index([userId])
  @@index([status])
  @@index([expiresAt])
  @@index([category])
  @@index([latitude, longitude])
}

model CommunityDealComment {
  id        String   @id @default(cuid())
  dealId    String
  userId    String
  text      String   @db.VarChar(100)
  createdAt DateTime @default(now())

  deal CommunityDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([userId])
  @@index([createdAt])
}

model CommunityDealVote {
  id        String   @id @default(cuid())
  dealId    String
  userId    String
  value     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal CommunityDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dealId, userId])
  @@index([dealId])
  @@index([userId])
  @@index([value])
}
