// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  BUSINESS
}

enum CouponStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  password          String
  name              String
  address           String?
  birthDate         DateTime?
  phone             String?
  about             String?   @db.Text
  businessDescription String? @db.Text
  businessCategories String[] @default([])
  businessLocation  String?
  businessWebsite   String?
  businessInstagram String?
  businessFacebook  String?
  businessTikTok    String?
  businessLatitude  Float?
  businessLongitude Float?
  role              Role      @default(USER)
  membershipExpiry  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  coupons           Coupon[]  @relation("BusinessCoupons")
  couponRedemptions CouponRedemption[]
  
  @@index([email])
  @@index([role])
}

model Category {
  id        String   @id @default(cuid())
  nameEn    String   @unique
  nameEl    String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  
  // Relations
  coupons   Coupon[]
  
  @@index([slug])
}

model Coupon {
  id                  String        @id @default(cuid())
  businessId          String
  categoryId          String
  title               String
  description         String        @db.Text
  code                String
  imagePath           String?
  discountPercentage  Int
  expirationDate      DateTime
  status              CouponStatus  @default(PENDING)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  // Relations
  business            User          @relation("BusinessCoupons", fields: [businessId], references: [id], onDelete: Cascade)
  category            Category      @relation(fields: [categoryId], references: [id])
  analytics           CouponAnalytics[]
  redemptions         CouponRedemption[]
  
  @@index([businessId])
  @@index([categoryId])
  @@index([status])
  @@index([expirationDate])
}

model CouponAnalytics {
  id          String   @id @default(cuid())
  couponId    String
  eventType   String   // 'VIEW', 'CLICK', 'REDEMPTION'
  userId      String?  // Optional - track which user (if authenticated)
  ipAddress   String?  // Optional - for anonymous tracking
  userAgent   String?  // Optional - browser/device info
  createdAt   DateTime @default(now())
  
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  
  @@index([couponId])
  @@index([eventType])
  @@index([createdAt])
  @@index([userId])
}

model CouponRedemption {
  id              String    @id @default(cuid())
  couponId        String
  userId          String
  redemptionToken String    @unique
  redeemedAt      DateTime?
  createdAt       DateTime  @default(now())
  
  coupon          Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([couponId, userId])
  @@index([redemptionToken])
  @@index([couponId])
  @@index([userId])
  @@index([redeemedAt])
}
